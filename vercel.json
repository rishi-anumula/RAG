{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,node_modules/**,docs/**,chroma_db/**,uploads/**,backend/venv/**,backend/tests/**,backend/chroma_db/**,backend/uploads/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/documents/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/documents",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|auth/|documents|chat|dashboard|health|docs|openapi.json|redoc).*)",
      "destination": "/index.html"
    }
  ]
}
