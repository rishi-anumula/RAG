# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES CONFIGURATION FOR RAG APPLICATION
# Add these variables in Vercel Dashboard > Project Settings > Environment Variables
# ==============================================================================

# Supabase Credentials (Required for Auth, Storage, and Vector Database)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (Required for RAG answers & text embeddings)
GOOGLE_API_KEY=your-google-gemini-api-key

# Backend Security Secret Key (Required for Auth token validation)
SECRET_KEY=your-custom-production-secret-key-32-chars-minimum

# Serverless RAG Configuration (Crucial for Vercel Serverless Functions)
USE_LOCAL_EMBEDDINGS=false
GEMINI_MODEL_NAME=gemini-2.0-flash
UPLOAD_FOLDER=/tmp/uploads

# Optional Frontend Override (Leave empty if deploying combined frontend + backend on Vercel)
VITE_API_URL=
